            </column>
            <column caption='F Rank' datatype='integer' name='[Calculation_256986695230042113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF RANK_PERCENTILE(SUM([Calculation_718324182041223169]), &apos;desc&apos;) &lt;= 0.2 THEN 5&#13;&#10;ELSEIF RANK_PERCENTILE(SUM([Calculation_718324182041223169]), &apos;desc&apos;) &lt;= 0.4 THEN 4&#13;&#10;ELSEIF RANK_PERCENTILE(SUM([Calculation_718324182041223169]), &apos;desc&apos;) &lt;= 0.6 THEN 3&#13;&#10;ELSEIF RANK_PERCENTILE(SUM([Calculation_718324182041223169]), &apos;desc&apos;) &lt;= 0.8 THEN 2&#13;&#10;ELSE 1&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='M Rank' datatype='integer' name='[Calculation_256986695230197762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF RANK_PERCENTILE(SUM([Calculation_718324182042234882]), &apos;desc&apos;) &lt;= 0.2 THEN 5&#13;&#10;ELSEIF RANK_PERCENTILE(SUM([Calculation_718324182042234882]), &apos;desc&apos;) &lt;= 0.4 THEN 4&#13;&#10;ELSEIF RANK_PERCENTILE(SUM([Calculation_718324182042234882]), &apos;desc&apos;) &lt;= 0.6 THEN 3&#13;&#10;ELSEIF RANK_PERCENTILE(SUM([Calculation_718324182042234882]), &apos;desc&apos;) &lt;= 0.8 THEN 2&#13;&#10;ELSE 1&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Recency' datatype='integer' name='[Calculation_718324182039265280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&#13;&#10;&apos;day&apos;,&#13;&#10;{FIXED [Customer ID] : MAX([Order Date])},&#13;&#10;{FIXED : MAX([Order Date])}&#13;&#10;)' />
            </column>
            <column caption='Frequency' datatype='integer' name='[Calculation_718324182041223169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Customer ID] : COUNTD([Order ID])}' />
            </column>
            <column caption='Monetary' datatype='real' name='[Calculation_718324182042234882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Customer ID] : SUM([Sales])}' />
            </column>
            <column caption='RFM Score' datatype='real' name='[Calculation_718324182053875717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_256986695229796352] + [Calculation_256986695230042113] + [Calculation_256986695230197762]) / 3'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Customer Segment' datatype='string' name='[Calculation_718324182054207494]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#13;&#10;RANK_PERCENTILE(SUM([Calculation_718324182039265280]), &apos;asc&apos;)&#13;&#10;+ RANK_PERCENTILE(SUM([Calculation_718324182041223169]), &apos;desc&apos;)&#13;&#10;+ RANK_PERCENTILE(SUM([Calculation_718324182042234882]), &apos;desc&apos;)&#13;&#10;) / 3 &gt;= 0.8 THEN &quot;Loyal&quot;&#13;&#10;ELSEIF (&#13;&#10;RANK_PERCENTILE(SUM([Calculation_718324182039265280]), &apos;asc&apos;)&#13;&#10;+ RANK_PERCENTILE(SUM([Calculation_718324182041223169]), &apos;desc&apos;)&#13;&#10;+ RANK_PERCENTILE(SUM([Calculation_718324182042234882]), &apos;desc&apos;)&#13;&#10;) / 3 &gt;= 0.6 THEN &quot;Active&quot;&#13;&#10;ELSEIF (&#13;&#10;RANK_PERCENTILE(SUM([Calculation_718324182039265280]), &apos;asc&apos;)&#13;&#10;+ RANK_PERCENTILE(SUM([Calculation_718324182041223169]), &apos;desc&apos;)&#13;&#10;+ RANK_PERCENTILE(SUM([Calculation_718324182042234882]), &apos;desc&apos;)&#13;&#10;) / 3 &gt;= 0.4 THEN &quot;New&quot;&#13;&#10;ELSE &quot;Lost&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
